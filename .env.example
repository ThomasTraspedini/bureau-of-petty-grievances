OPENAI_API_KEY=
BUREAU_OPENAI_MODEL=gpt-5.6-luna
DATABASE_URL=
# Required outside local development and test. Use the public HTTPS origin only.
BUREAU_PUBLIC_ORIGIN=http://localhost:3000
# Local development only; ignored when DATABASE_URL is configured.
BUREAU_EMBEDDED_DATABASE_PATH=.data/public-records
# Required for production evaluator access. Use at least 32 random characters.
BUREAU_NETWORK_HMAC_SECRET=
# Number of trusted proxy-appended addresses to skip from the right of X-Forwarded-For.
BUREAU_TRUSTED_PROXY_HOPS=0
# Optional categorical usage-alert delivery.
BUREAU_ALERT_WEBHOOK_URL=
BUREAU_ALERT_WEBHOOK_SECRET=
# Explicit, server-only product analytics. Keep false until the Mixpanel project
# is configured with the documented 180-day retention and privacy controls.
BUREAU_ANALYTICS_ENABLED=false
BUREAU_MIXPANEL_PROJECT_TOKEN=
BUREAU_MIXPANEL_REGION=eu
# Required when analytics is enabled. Use at least 32 random characters.
BUREAU_ANALYTICS_HMAC_SECRET=
BUREAU_ANALYTICS_RETENTION_DAYS=180
BUREAU_APPLICATION_VERSION=0.13.0
# Version the price snapshot separately from the application release.
BUREAU_ANALYTICS_PRICING_VERSION=
BUREAU_ANALYTICS_INPUT_MICROUSD_PER_MILLION_TOKENS=
BUREAU_ANALYTICS_OUTPUT_MICROUSD_PER_MILLION_TOKENS=
